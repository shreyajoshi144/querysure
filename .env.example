# QuerySure local configuration
ENVIRONMENT=development
DATABASE_URL=sqlite:///./querysure.db
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ALLOWED_ORIGINS=*
REDIS_URL=
TRUSTED_PROXY_IPS=
CSP_REPORT_ONLY=0

# Docker Compose (required by `docker compose up`; Compose stops with a message if they are missing).
# Choose your own values. JWT_SECRET_KEY above is also required: python -c "import secrets; print(secrets.token_urlsafe(64))".
# The password is inserted into a database URL, so use letters, digits, '-' or '_' only.
POSTGRES_USER=querysure
POSTGRES_PASSWORD=
POSTGRES_DB=querysure

# Authentication email delivery
# Local default: "dev" writes verification/reset emails to .dev_mail/*.eml so you can sign up without an SMTP
# account. Production refuses to start unless this is "smtp" and the SMTP_* values below are set.
EMAIL_PROVIDER=dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
APP_BASE_URL=http://localhost:5000
# Google Identity Services OAuth 2.0 Web Client ID (public identifier; never put a client secret here)
GOOGLE_CLIENT_ID=

# LLM providers (at least one key). Model defaults live in config.py; override with GROQ_MODEL,
# GROQ_FALLBACK_MODEL, OPENAI_FALLBACK_MODEL, ANTHROPIC_FALLBACK_MODEL when providers retire models.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DAILY_LLM_BUDGET_USD=2.00

# Optional object storage
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=datasets
S3_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public contact address used by the landing-page Business plan.
PRODUCT_CONTACT_EMAIL=

# Concurrency/worker sizing. 1 web worker is the right local default (SQLite); render.yaml sets 2 for production.
WEB_CONCURRENCY=1
THREADPOOL_MAX_WORKERS=20
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
CONCURRENCY_GENERATE_SQL=2
CONCURRENCY_UPLOAD=1
CONCURRENCY_EXECUTE_SQL=1
MAX_INGEST_ROWS=1000000
MAX_INGEST_COLUMNS=200
MAX_INGEST_SHEETS=20
MAX_XLSX_UNCOMPRESSED_MB=512
MAX_XLSX_COMPRESSION_RATIO=100
TRUSTED_PROXY_IPS=
# In production, set this to the exact trusted proxy IP/CIDR values for the deployment; never use *.
# Run: workers * (DB_POOL_SIZE + DB_MAX_OVERFLOW) must remain below the Postgres connection limit.

# --- Sprint 4: observability, reliability & operations (see docs/OPERATIONS.md) ---
# Comma-separated e-mails allowed to open /ops and /api/admin/ops/* (verified accounts only). Empty = nobody.
ADMIN_EMAILS=
# Optional scraper token for GET /api/admin/ops/metrics (Prometheus text). Blank = scraper access off.
OPS_METRICS_TOKEN=
# Optional error tracker (pip install sentry-sdk). Only exception type + frames are ever sent.
SENTRY_DSN=
# Alert delivery (https in production). Alerts are always also logged and stored as incidents.
ALERTS_ENABLED=
ALERT_WEBHOOK_URL=
# LOG_FORMAT=json|text, LOG_LEVEL=INFO, AI_PROVIDER_TIMEOUT_SECONDS=25, AI_REQUEST_DEADLINE_SECONDS=60,
# API_ADMISSION_LIMIT (default threadpool-4), JOB_STALE_SECONDS=1500, SLO_* and ALERT_* thresholds: see config.py

# ---------------------------------------------------------------------------
# Sprint 5: billing (provider-neutral). Leave PAYMENT_PROVIDER empty to run Free-only (checkout -> BILLING_NOT_CONFIGURED).
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=
# Comma-separated webhook signing secrets (16+ chars each); several at once allows zero-downtime rotation.
PAYMENT_WEBHOOK_SECRETS=
# Generic HMAC adapter only: hosted checkout page, the secret QuerySure signs that link with, optional customer portal.
PAYMENT_CHECKOUT_URL=
PAYMENT_CHECKOUT_SIGNING_SECRET=
PAYMENT_PORTAL_URL=
# Provider price id -> QuerySure plan, e.g. {"price_abc": "pro"}. Only "pro" is purchasable.
BILLING_PLAN_MAP_JSON=
BILLING_WEBHOOK_TOLERANCE_SECONDS=300
BILLING_GRACE_HOURS=72
BILLING_CHECKOUT_TTL_MINUTES=30
BILLING_UNRESOLVED_RETRY_HOURS=24
# Tokens carry a server-side session id. Pre-Sprint-5 tokens are refused when this is 1 (the production default).
AUTH_REQUIRE_SESSION_ID=0
AUTH_MAX_ACTIVE_SESSIONS=20
# Seconds between two verification/reset e-mails to one account (60 in production, 0 elsewhere).
AUTH_EMAIL_COOLDOWN_SECONDS=0
